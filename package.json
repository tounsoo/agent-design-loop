{
  "name": "agent-design-loop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts products/meridian",
    "dev:nook": "vite --config vite.config.ts products/nook",
    "build": "vite build --config vite.config.ts products/meridian",
    "preview": "vite preview --config vite.config.ts products/meridian",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:product-ui": "tsx packages/harness/src/lint-product-ui.ts",
    "lint:slots": "tsx packages/harness/src/check-slots.ts",
    "check:step-budget": "tsx packages/harness/src/check-step-budget.ts",
    "check:state-coverage": "tsx packages/harness/src/check-state-coverage.ts",
    "check:disclosure": "tsx packages/harness/src/check-disclosure.ts",
    "check:priority": "tsx packages/harness/src/check-priority.ts",
    "check:one-thing": "tsx packages/harness/src/check-one-thing.ts",
    "check:inventories": "tsx packages/harness/src/check-inventories.ts",
    "check:target-size": "tsx packages/harness/src/check-target-size.ts",
    "check:accessible-names": "tsx packages/harness/src/check-accessible-names.ts",
    "setup:chrome": "tsx packages/harness/src/setup-chrome.ts",
    "check:opt-outs": "tsx packages/harness/src/check-opt-outs.ts",
    "check:retirement": "tsx packages/harness/src/check-retirement.ts",
    "check:proposals": "tsx packages/harness/src/check-proposals.ts",
    "check:loop": "tsx packages/harness/src/check-loop.ts",
    "check:trace": "tsx packages/harness/src/check-trace.ts",
    "loop:step": "tsx packages/harness/src/loop-step.ts",
    "test": "vitest run",
    "check:rules": "npm run lint:product-ui && npm run lint:slots && npm run check:step-budget && npm run check:disclosure && npm run check:priority && npm run check:one-thing && npm run check:inventories && npm run check:state-coverage && npm run check:target-size && npm run check:accessible-names",
    "check:product": "tsx packages/harness/src/check-product.ts",
    "check:meridian": "npm run check:product -- --config products/meridian/harness.config.ts",
    "check:nook": "npm run check:product -- --config products/nook/harness.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:meridian && npm run check:nook && npm run check:proposals && npm run check:retirement && npm run check:loop",
    "check:fixtures": "tsx packages/harness/src/check-fixtures.ts"
  },
  "dependencies": {
    "@tounsoo/todae": "0.10.1",
    "lucide-react": "^1.71.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@puppeteer/browsers": "^2.13.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.0.1",
    "puppeteer-core": "^24.29.0",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
